digraph Flujo {
 graph [rankdir=LR, bgcolor=white, pad=0.34, ranksep=0.65, nodesep=0.32, splines=ortho,
       label="Proceso de telemedicina — 10 pasos", labelloc=t, fontname="DejaVu Sans", fontsize=23];
 node [shape=box, style="rounded,filled", color="#9AC9CE", fillcolor="#E8F6F8",
       fontname="DejaVu Sans", fontsize=12, margin="0.20,0.14"];
 edge [color="#3A8D91", penwidth=1.8, arrowsize=0.65];
 p1 [label="1. Solicitud\nPaciente"];
 p2 [label="2. Recepción\nAdmisión"];
 p3 [label="3. Seguro\nAdmisión"];
 p4 [label="4. Agenda\nAdmisión"];
 p5 [label="5. Confirmación\nAdmisión"];
 p6 [label="6. Consentimiento\nPaciente"];
 p7 [label="7. Consulta\nMédico / Apoyo", fillcolor="#E1EFEA"];
 p8 [label="8. Resultados\nMédico", fillcolor="#E1EFEA"];
 p9 [label="9. Cierre\nFacturación", fillcolor="#FFF2D9", color="#E4BE70"];
 p10 [label="10. Seguimiento\nPaciente / Admisión", fillcolor="#FFF2D9", color="#E4BE70"];
 p1 -> p2 -> p3 -> p4 -> p5 -> p6 -> p7 -> p8 -> p9 -> p10;
}
